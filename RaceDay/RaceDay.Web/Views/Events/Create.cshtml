@model RaceDay.Web.Models.EventViewModel
@{ ViewData["Title"] = "Create event"; }
<div class="form-panel"><a asp-controller="Dashboard" asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Dashboard</a><h1 class="mt-3">Create a running event</h1><p class="text-secondary">Add the event information participants need to join.</p><form asp-action="Create" method="post" class="row g-3"><div asp-validation-summary="All" class="text-danger"></div><div class="col-md-6"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control"/><span asp-validation-for="EventName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="EventType" class="form-label"></label><input asp-for="EventType" class="form-control" placeholder="Road Running, Trail, Fun Run"/></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-6"><label asp-for="Distance" class="form-label">Distance (km)</label><input asp-for="Distance" type="number" step="0.01" min="0.01" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">Create event</button></div></form></div>
