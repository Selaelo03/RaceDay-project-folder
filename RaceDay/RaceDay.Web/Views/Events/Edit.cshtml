@model RaceDay.Web.Models.EventViewModel
@{ ViewData["Title"] = "Edit event"; }
<div class="form-panel"><a asp-action="Details" asp-route-id="@Model.EventID" class="back-link">← Back to event</a><h1 class="mt-3">Edit event</h1><form asp-action="Edit" asp-route-id="@Model.EventID" method="post" class="row g-3"><input asp-for="EventID" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="col-md-6"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control"/></div><div class="col-md-6"><label asp-for="EventType" class="form-label"></label><input asp-for="EventType" class="form-control"/></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-6"><label asp-for="Distance" class="form-label">Distance (km)</label><input asp-for="Distance" type="number" step="0.01" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">Save changes</button></div></form></div>
