@using System.Text.Json
@using RaceDay.Web.Models
@{ ViewData["Title"] = "Event details"; JsonElement ev = (JsonElement)ViewBag.Event; var categories = ViewBag.Categories is JsonElement cj && cj.ValueKind == JsonValueKind.Array ? cj.EnumerateArray().ToList() : new List<JsonElement>(); var role = ViewBag.Role as string; }
<div class="mb-4"><a asp-controller="Home" asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Back to events</a></div>
<div class="detail-hero"><span class="event-type">@ev.GetProperty("eventType").GetString()</span><h1>@ev.GetProperty("eventName").GetString()</h1><p>@(ev.TryGetProperty("description",out var description) ? description.ToString() : "Discover the details and take part in this event.")</p><div class="detail-meta"><span><i class="bi bi-calendar3"></i>@ev.GetProperty("eventDate").ToString().Split('T')[0]</span><span><i class="bi bi-geo-alt"></i>@ev.GetProperty("location").GetString()</span><span><i class="bi bi-signpost-2"></i>@ev.GetProperty("distance") km</span></div></div>
<div class="row g-4 mt-1"><div class="col-lg-7"><section class="content-panel"><h2>Race information</h2><p>@(ev.TryGetProperty("description",out var longDescription) ? longDescription.ToString() : "No additional event description has been provided.")</p><dl class="detail-list"><dt>Event date</dt><dd>@ev.GetProperty("eventDate").ToString()</dd><dt>Location</dt><dd>@ev.GetProperty("location").GetString()</dd><dt>Distance</dt><dd>@ev.GetProperty("distance") km</dd><dt>Event type</dt><dd>@ev.GetProperty("eventType").GetString()</dd></dl></section></div><div class="col-lg-5"><section class="content-panel"><h2>Race categories</h2>@if(categories.Count == 0){<p class="text-secondary">No categories have been added to this event yet.</p>}else{foreach(var c in categories){<div class="category-row"><div><strong>@c.GetProperty("categoryName").GetString()</strong><small>@c.GetProperty("categoryType").GetString() · @(c.TryGetProperty("distance",out var cd) && cd.ValueKind != JsonValueKind.Null ? cd.ToString()+" km" : "Distance to be confirmed")</small></div>@if(role == "Participant"){<form asp-controller="Enrollments" asp-action="Create" method="post"><input type="hidden" name="eventId" value="@ev.GetProperty("eventID").GetInt32()"/><input type="hidden" name="categoryId" value="@c.GetProperty("categoryID").GetInt32()"/><button class="btn btn-primary btn-sm" type="submit">Enroll</button></form>}</div>}}@if(role == "Organiser"){<hr/><h3 class="h5">Add a category</h3><form asp-action="AddCategory" method="post"><input type="hidden" name="id" value="@ev.GetProperty("eventID").GetInt32()"/><div class="mb-2"><label class="form-label">Category name</label><input name="CategoryName" class="form-control" required maxlength="100" placeholder="e.g. 10 km Open"/></div><div class="mb-2"><label class="form-label">Category type</label><input name="CategoryType" class="form-control" required maxlength="50" placeholder="Open / Junior / Masters"/></div><div class="row"><div class="col-6 mb-2"><label class="form-label">Minimum age</label><input name="MinimumAge" type="number" min="0" max="150" class="form-control"/></div><div class="col-6 mb-2"><label class="form-label">Maximum age</label><input name="MaximumAge" type="number" min="0" max="150" class="form-control"/></div></div><div class="mb-3"><label class="form-label">Distance (km)</label><input name="Distance" type="number" min="0.01" step="0.01" class="form-control"/></div><button class="btn btn-primary w-100">Add category</button></form><a class="btn btn-outline-primary w-100 mt-2" asp-controller="Results" asp-action="EventEnrollments" asp-route-eventId="@ev.GetProperty("eventID").GetInt32()">View participants / record results</a><a class="btn btn-outline-secondary w-100 mt-2" asp-action="Edit" asp-route-id="@ev.GetProperty("eventID").GetInt32()">Edit event</a><form asp-action="Delete" method="post" class="mt-2" onsubmit="return confirm('Delete this event? This cannot be undone.');"><input type="hidden" name="id" value="@ev.GetProperty("eventID").GetInt32()"/><button class="btn btn-outline-danger w-100">Delete event</button></form>}</section></div></div>
