@using System.Text.Json
@{ ViewData["Title"] = "Discover Events"; var events = ViewBag.Events is JsonElement j && j.ValueKind == JsonValueKind.Array ? j.EnumerateArray().ToList() : new List<JsonElement>(); }
<section class="hero-panel mb-5"><div class="hero-content"><span class="eyebrow">YOUR NEXT STARTING LINE</span><h1>Run your race.<br/><span>Make your mark.</span></h1><p>Discover running events, challenge yourself and connect with your community.</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-light btn-lg" asp-controller="Account" asp-action="Register">Get started <i class="bi bi-arrow-right"></i></a><a class="btn btn-outline-light btn-lg" href="#events">Explore events</a></div></div><div class="hero-mark" aria-hidden="true">🏁</div></section>
<div id="events" class="section-heading"><div><span class="eyebrow text-primary">FIND YOUR NEXT CHALLENGE</span><h2>Upcoming events</h2><p class="text-secondary mb-0">Browse races and find the one that moves you.</p></div><span class="count-pill">@events.Count events</span></div>
<div class="row g-4 mt-1">@if(events.Count == 0){<div class="col-12"><div class="empty-state"><i class="bi bi-calendar2-x"></i><h3>No events are currently available</h3><p>Check back soon for upcoming RaceDay events.</p></div></div>}@foreach(var e in events){<div class="col-md-6 col-xl-4"><article class="event-card h-100"><div class="event-card-top"><span class="event-type">@e.GetProperty("eventType").GetString()</span><i class="bi bi-flag"></i></div><div class="event-card-body"><h3>@e.GetProperty("eventName").GetString()</h3><p class="event-description">@(e.TryGetProperty("description",out var desc) ? desc.ToString() : "Join this RaceDay event and take on a new challenge.")</p><div class="event-meta"><span><i class="bi bi-calendar3"></i>@e.GetProperty("eventDate").ToString().Split('T')[0]</span><span><i class="bi bi-geo-alt"></i>@e.GetProperty("location").GetString()</span><span><i class="bi bi-signpost-2"></i>@e.GetProperty("distance") km</span></div><a class="btn btn-primary w-100 mt-3" asp-controller="Events" asp-action="Details" asp-route-id="@e.GetProperty("eventID").GetInt32()">View details <i class="bi bi-arrow-right"></i></a></div></article></div>}</div>
