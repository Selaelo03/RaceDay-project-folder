@using System.Text.Json
@{ ViewData["Title"] = "Dashboard"; var role = ViewBag.Role as string; var events = ViewBag.Events is JsonElement j && j.ValueKind == JsonValueKind.Array ? j.EnumerateArray().ToList() : new List<JsonElement>(); }
<section class="dashboard-welcome"><span class="eyebrow">RACEDAY ACCOUNT</span><h1>Welcome, @Context.Session.GetString("UserName")</h1><p>Manage your running journey from one place.</p></section>
@if(role == "Organiser"){
<div class="row g-3 mb-4"><div class="col-md-4"><a class="quick-action" asp-controller="Events" asp-action="Create"><i class="bi bi-plus-circle"></i><span><strong>Create event</strong><small>Publish a new race</small></span></a></div><div class="col-md-4"><a class="quick-action" asp-controller="Home" asp-action="Index"><i class="bi bi-calendar-event"></i><span><strong>Browse events</strong><small>View public event listings</small></span></a></div></div>
}else{
<div class="row g-3 mb-4"><div class="col-md-4"><a class="quick-action" asp-controller="Enrollments" asp-action="Index"><i class="bi bi-calendar2-check"></i><span><strong>My enrollments</strong><small>View races you've joined</small></span></a></div><div class="col-md-4"><a class="quick-action" asp-controller="Results" asp-action="Index"><i class="bi bi-trophy"></i><span><strong>My results</strong><small>Track your performance</small></span></a></div><div class="col-md-4"><a class="quick-action" asp-controller="Home" asp-action="Index"><i class="bi bi-search"></i><span><strong>Find an event</strong><small>Discover your next race</small></span></a></div></div>
}
<div class="section-heading"><div><h2>Available events</h2><p class="text-secondary mb-0">Events currently listed on RaceDay.</p></div></div><div class="row g-3">@if(events.Count == 0){<div class="col-12"><p class="text-secondary">No events found. Check that the API is running.</p></div>}@foreach(var e in events){<div class="col-md-6 col-xl-4"><div class="event-card h-100 p-3"><span class="event-type">@e.GetProperty("eventType").GetString()</span><h3 class="h5 mt-3">@e.GetProperty("eventName").GetString()</h3><p class="text-secondary">@e.GetProperty("location").GetString() · @e.GetProperty("eventDate").ToString().Split('T')[0]</p><a class="btn btn-outline-primary btn-sm" asp-controller="Events" asp-action="Details" asp-route-id="@e.GetProperty("eventID").GetInt32()">View details</a>@if(role == "Organiser"){<a class="btn btn-outline-secondary btn-sm ms-1" asp-controller="Results" asp-action="EventEnrollments" asp-route-eventId="@e.GetProperty("eventID").GetInt32()">Participants & results</a>}</div></div>}</div>
