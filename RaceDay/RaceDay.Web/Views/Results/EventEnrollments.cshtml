@using System.Text.Json
@using RaceDay.Web.Models
@{ ViewData["Title"] = "Event participants"; var items = ViewBag.Enrollments is JsonElement j && j.ValueKind == JsonValueKind.Array ? j.EnumerateArray().ToList() : new List<JsonElement>(); int eventId = (int)ViewBag.EventId; }
<div class="section-heading"><div><span class="eyebrow text-primary">ORGANISER WORKSPACE</span><h1>Event participants</h1><p class="text-secondary">Review entries and record finishing results.</p></div></div>
@if(items.Count == 0){<div class="empty-state"><i class="bi bi-people"></i><h3>No participants enrolled</h3><p>Participants will appear here after enrolling in a race category.</p></div>}else{<div class="row g-3">@foreach(var e in items){<div class="col-12"><div class="content-panel"><div class="d-flex justify-content-between flex-wrap gap-2"><div><h3 class="h5 mb-1">@e.GetProperty("firstName").GetString() @e.GetProperty("lastName").GetString()</h3><p class="text-secondary mb-2">@e.GetProperty("categoryName").GetString() · Enrolled @e.GetProperty("enrollmentDate").ToString().Split('T')[0]</p></div><span class="count-pill">Entry #@e.GetProperty("enrollmentID")</span></div><form asp-action="Record" method="post" class="row g-2 align-items-end"><input type="hidden" name="eventId" value="@eventId"/><input type="hidden" name="enrollmentId" value="@e.GetProperty("enrollmentID").GetInt32()"/><div class="col-sm-5"><label class="form-label">Finish time (hh:mm:ss)</label><input name="FinishTime" class="form-control" value="00:30:00" required pattern="[0-9]{2}:[0-9]{2}:[0-9]{2}"/></div><div class="col-sm-3"><label class="form-label">Finishing position</label><input name="FinishingPosition" type="number" min="1" class="form-control" value="1" required/></div><div class="col-sm-4"><button class="btn btn-primary w-100">Record result</button></div></form></div></div>}</div>}
