@using System.Text.Json
@{ ViewData["Title"] = "My Results"; var items = ViewBag.Results is JsonElement j && j.ValueKind == JsonValueKind.Array ? j.EnumerateArray().ToList() : new List<JsonElement>(); }
<div class="section-heading"><div><span class="eyebrow text-primary">YOUR PERFORMANCE</span><h1>My race results</h1><p class="text-secondary">Review your recorded finishing times and positions.</p></div></div>
@if(items.Count == 0){<div class="empty-state"><i class="bi bi-trophy"></i><h3>No results available yet</h3><p>Your results will appear here after an organiser records them.</p></div>}else{<div class="table-responsive content-panel"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var r in items){<tr><td>@r.GetProperty("eventName").GetString()</td><td>@r.GetProperty("eventDate").ToString().Split('T')[0]</td><td>@r.GetProperty("categoryName").GetString()</td><td>@r.GetProperty("finishTime").ToString()</td><td><span class="position-pill">#@r.GetProperty("finishingPosition")</span></td></tr>}</tbody></table></div>}
