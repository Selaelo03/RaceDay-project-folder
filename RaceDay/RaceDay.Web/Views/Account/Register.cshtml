@model RegisterViewModel
@{ViewData["Title"]="Register";}<h2>Create your RaceDay account</h2><form method="post" class="row g-3"><div asp-validation-summary="All" class="text-danger"></div><div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control"/></div><div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control"/></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div><div class="col-md-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control"/></div><div class="col-md-6"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option>Participant</option><option>Organiser</option></select></div><div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control"/></div><div class="col-md-6"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control"/></div><div class="col-md-6"><label asp-for="OrganisationName" class="form-label">Organisation name (Organisers)</label><input asp-for="OrganisationName" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">Register</button></div></form>
