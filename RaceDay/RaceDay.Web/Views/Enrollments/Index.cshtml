@using System.Text.Json
@{ ViewData["Title"] = "My Enrollments"; var items = ViewBag.Enrollments is JsonElement j && j.ValueKind == JsonValueKind.Array ? j.EnumerateArray().ToList() : new List<JsonElement>(); }
<div class="section-heading"><div><span class="eyebrow text-primary">YOUR RACE CALENDAR</span><h1>My enrolled events</h1><p class="text-secondary">Keep track of the races you've joined.</p></div><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Explore events</a></div>
@if(items.Count == 0){<div class="empty-state"><i class="bi bi-calendar2-check"></i><h3>No enrollments yet</h3><p>Explore upcoming events and choose a category to enrol.</p><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse events</a></div>}else{<div class="table-responsive content-panel"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Category</th><th>Enrolled</th></tr></thead><tbody>@foreach(var e in items){<tr><td><strong>@e.GetProperty("eventName").GetString()</strong></td><td>@e.GetProperty("eventDate").ToString().Split('T')[0]</td><td>@e.GetProperty("location").GetString()</td><td>@e.GetProperty("categoryName").GetString()</td><td>@e.GetProperty("enrollmentDate").ToString().Split('T')[0]</td></tr>}</tbody></table></div>}
